{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btarcet.example/contracts/session.schema.json",
  "title": "Session",
  "type": "object",
  "required": ["id", "title", "startDateTime", "speakers"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "startDateTime": { "type": "string", "format": "date-time" },
    "durationMinutes": { "type": "number", "minimum": 1 },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "speakers": {
      "type": "array",
      "items": { "$ref": "#/definitions/speaker" },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/definitions/resource" },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "definitions": {
    "speaker": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "roleOrTitle": { "type": "string" },
        "organization": { "type": "string" }
      }
    },
    "resource": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}
