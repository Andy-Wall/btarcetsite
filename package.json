{
  "name": "btarcetsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-paths.js",
    "start": "next start",
    "lint": "next lint",
    "export": "test -d out && echo '✓ Static export ready: out/ directory contains static site' || (echo '✗ Error: out/ directory not found. Run pnpm build first.' && exit 1)",
    "validate:sessions": "node scripts/validate-sessions.js",
    "check:a11y": "node scripts/check-a11y.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.e2e.config.ts --ui",
    "test:e2e:debug": "playwright test --config=playwright.e2e.config.ts --debug"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.0.1",
    "eslint": "^10",
    "eslint-config-next": "^16.1.6",
    "playwright": "^1.57.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  }
}
